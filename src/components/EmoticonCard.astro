---
import { makeUnbreakable, type Emoticon } from "../data";

interface Props {
  emoticon: Emoticon;
}

const { emoticon } = Astro.props;
const unbreakable = makeUnbreakable(emoticon.emoticon);
---

<div
  class="card"
  role="button"
  tabindex="0"
  aria-label={`Copy ${emoticon.emoticon}`}
  data-emoticon={unbreakable}
  data-copied="false"
>
  <div class="content">
    <div class="emoticon">{unbreakable}</div>

    <button class="copy-button" type="button" tabindex="-1">
      <span class="label">Copy</span>
      <span class="label-copied" aria-hidden="true">Copied!</span>
    </button>
  </div>

  <div class="sparkle-overlay" aria-hidden="true">✨</div>
  <div class="sparkle-overlay sparkle-overlay--late" aria-hidden="true">☆</div>
</div>

<style>
  .card {
    position: relative;
    padding: 1rem;
    border-radius: 1rem;
    border: 2px solid rgba(236, 147, 191, 0.28);
    background: linear-gradient(
      160deg,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(251, 242, 247, 0.92) 100%
    );
    cursor: pointer;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease;

    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .card:hover,
  .card:focus-visible {
    transform: translateY(-4px) rotate(-0.4deg);
    border-color: rgba(236, 147, 191, 0.7);
    box-shadow: 0 12px 28px rgba(236, 147, 191, 0.22);
    outline: none;
  }

  .card:focus-visible {
    box-shadow:
      0 0 0 3px rgba(179, 230, 213, 0.7),
      0 12px 28px rgba(236, 147, 191, 0.22);
  }

  .card[data-copied="true"] {
    border-color: #6ee7b7;
    background: rgba(110, 231, 183, 0.14);
  }

  .content {
    text-align: center;
  }

  .emoticon {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
    font-weight: 500;
    /* Ensure user cannot accidentally select */
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    word-break: keep-all;
  }

  .copy-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 5.5rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 999px;
    border: none;
    background: rgba(236, 147, 191, 0.22);
    color: hsl(332, 35%, 32%);
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .card:hover .copy-button,
  .card:focus-visible .copy-button {
    background: hsl(332, 55%, 62%);
    color: #fff;
  }

  .label-copied {
    display: none;
  }

  .card[data-copied="true"] .label {
    display: none;
  }

  .card[data-copied="true"] .label-copied {
    display: inline;
  }

  .card[data-copied="true"] .copy-button {
    background: #34d399;
    color: #064e3b;
  }

  .sparkle-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    pointer-events: none;
    opacity: 0;
  }

  .sparkle-overlay--late {
    font-size: 1.4rem;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 0.6rem 0.8rem 0 0;
  }

  .card[data-copied="true"] .sparkle-overlay {
    animation: ping 0.8s ease-out forwards;
  }

  .card[data-copied="true"] .sparkle-overlay--late {
    animation: ping 0.8s ease-out 0.12s forwards;
  }

  @keyframes ping {
    from {
      transform: scale(0.8);
      opacity: 0.6;
    }
    to {
      transform: scale(1.4);
      opacity: 0;
    }
  }
</style>
