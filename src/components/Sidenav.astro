---
import type { emoticons } from "../data";
import { categoryInfo, type Category } from "../data/categories";

interface Props {
  groupedEmoticons: {
    category: Category;
    emoticons: typeof emoticons;
  }[];
}

const { groupedEmoticons } = Astro.props;
---

<div class="wrapper">
  <div class="curtain-backdrop" aria-hidden="true"></div>
  <div class="curtain-panel">
    <button
      type="button"
      class="curtain-close"
      aria-label="Close menu"
    >
      <span aria-hidden="true">×</span>
    </button>
    <nav class="side-nav" aria-label="Category navigation">
      <div class="header">
        <svg
          class="sparkle-svg"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"
          ></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path
            d="M4 17v2"></path><path d="M5 18H3"></path></svg
        >
        <span>Categories</span>
      </div>
      <div class="nav-list-wrapper">
        <p class="nav-list-title">Jump to section</p>
        <ul class="nav-list">
          {
            groupedEmoticons.map(({ category, emoticons: catEmoticons }) => (
              <li>
                <a href={`#${category}`} class="nav-link">
                  <span class="nav-icon">{categoryInfo[category].navIcon}</span>
                  <span class="nav-label">{categoryInfo[category].label}</span>
                  <span class="nav-count">{catEmoticons.length}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>
</div>

<style>
  .wrapper {
    height: 100%;
    background-color: rgb(248, 242, 245);
  }

  .curtain-backdrop {
    display: none;
  }

  .curtain-close {
    display: none;
  }

  .curtain-panel {
    height: 100%;
  }

  .side-nav {
    position: sticky;
    top: 0;
    width: 250px;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 767px) {
    .wrapper {
      position: static;
      width: 0;
      min-width: 0;
      overflow: visible;
      background-color: transparent;
    }

    .curtain-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 100;
      background-color: rgba(0, 0, 0, 0.4);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    :global(body.curtain-open) .curtain-backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    .curtain-panel {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      z-index: 101;
      width: min(85vw, 300px);
      height: 100%;
      background-color: rgb(248, 242, 245);
      transform: translateX(-100%);
      transition: transform 0.25s ease;
      display: flex;
      flex-direction: column;
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.15);
    }

    :global(body.curtain-open) .curtain-panel {
      transform: translateX(0);
    }

    .curtain-close {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 16px;
      right: 16px;
      z-index: 3;
      width: 2.5rem;
      height: 2.5rem;
      padding: 0;
      border: none;
      border-radius: 50%;
      background: hsl(332, 31%, 88%);
      color: var(--accent-text-color);
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .curtain-close:hover {
      background: hsl(280, 60%, 90%);
    }

    .side-nav {
      position: relative;
      width: 100%;
      flex: 1;
      min-height: 0;
    }

    .header {
      padding-right: 3rem;
    }
  }

  .sparkle-svg {
    width: 1.25rem;
    height: 1.25rem;
    color: hsl(330 70% 75%);
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 2;
    background-color: rgb(248, 242, 245);
    padding: 16px;
    border-bottom: 1px solid rgba(234, 215, 224, 0.5);
    display: flex;
    gap: 12px;
    font-weight: 700;
  }

  .header span {
    background-image: linear-gradient(
      to right,
      rgb(236, 147, 191),
      rgb(224, 194, 240)
    );
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  .nav-list-wrapper {
    overflow-y: auto;

    /* We never know when scrollbar a wild scrollbar may appear… */
    scrollbar-gutter: stable;
  }

  .nav-list-title {
    margin: 0;
    padding: 16px 16px 0 16px;
  }

  .nav-list-title {
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-size: var(--12px);
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    padding: 8px;
    gap: 4px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 8px;
    height: 2rem;
    font-size: var(--14px);
    border-radius: 16px;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    background-color: hsl(332, 31%, 88%);
    font-weight: 500;
  }

  .nav-link:active {
    background-color: hsl(280, 60%, 90%);
  }

  .nav-icon {
    font-size: var(--18px);
  }

  .nav-label {
    color: var(--accent-text-color);
  }

  .nav-count {
    margin-left: auto;
    color: var(--accent-text-color);
    opacity: 0.7;
    font-size: var(--12px);
  }
</style>
